@startuml "JSONB-Option1"
!define table(x) class x << (T,#FFAAAA) >>
!define pk(x) <u>x</u>
!define fk(x) <i>x</i>

title
<size:16><b>Pipeline Management - Database Schema</b></size>
<size:12>JSONB Option</size>
end title

table(sources) {
  pk(id) : UUID
  name : VARCHAR(255) UNIQUE NOT NULL
  source_type : VARCHAR(50) NOT NULL
  config_data : JSONB NOT NULL
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

table(pipelines) {
  pk(id) : UUID
  fk(source_id) : UUID
  fk(sink_id) : UUID
  fk(task_id) : UUID
  name : VARCHAR(255) UNIQUE NOT NULL
  description : TEXT
  is_running : BOOLEAN DEFAULT FALSE
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

table(sinks) {
  pk(id) : UUID
  name : VARCHAR(255) UNIQUE NOT NULL
  sink_type : VARCHAR(50)
  rate_limit : FLOAT DEFAULT NULL
  config_data : JSONB NOT NULL
  output_formats : JSONB NOT NULL
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

table(tasks) {
  pk(id) : UUID
  type: TEXT NOT NULL
  ...
}

sources ||--o{ pipelines : "one source can be used by many pipelines"
sinks ||--o{ pipelines : "one sink can be used by many pipelines"
pipelines ||--|| tasks : "one pipeline addresses one specific task"

note right of sources
  Stores configuration for
  different data sources
end note

note right of pipelines
  Main orchestration entity
  that connects models with sources and sinks
end note

note right of sinks
  Output destinations
  for pipeline data
end note

note right of tasks
  Machine learning task,
  namely the definition
  of the problem to solve
end note

@enduml
